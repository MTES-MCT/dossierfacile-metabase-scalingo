#!/usr/bin/env bash

set -e

export PATH="/app/bin:$PATH"

# Metabase écoutera en local sur 8080 (le PORT de Scalingo reste réservé à oauth2-proxy)
export MB_JETTY_PORT="8080"

# Scalingo Postgres
if [ "$DATABASE_URL" ]; then
    if [[ $DATABASE_URL == *"?"* ]]; then
        export MB_DB_CONNECTION_URI="$DATABASE_URL"
    else
        export MB_DB_CONNECTION_URI="$DATABASE_URL?ssl=true&sslmode=require&sslfactory=org.postgresql.ssl.NonValidatingFactory"
    fi
fi

# Mailgun (Scalingo)
if [ "$MAILGUN_SMTP_LOGIN" ]; then
    export MB_EMAIL_SMTP_HOST="$MAILGUN_SMTP_SERVER"
    export MB_EMAIL_SMTP_PORT="$MAILGUN_SMTP_PORT"
    export MB_EMAIL_SMTP_USERNAME="$MAILGUN_SMTP_LOGIN"
    export MB_EMAIL_SMTP_PASSWORD="$MAILGUN_SMTP_PASSWORD"
fi

# SendGrid (Scalingo)
if [ "$SENDGRID_USERNAME" ]; then
    export MB_EMAIL_SMTP_HOST="smtp.sendgrid.net"
    export MB_EMAIL_SMTP_PORT="587"
    export MB_EMAIL_SMTP_USERNAME="$SENDGRID_USERNAME"
    export MB_EMAIL_SMTP_PASSWORD="$SENDGRID_PASSWORD"
    export MB_EMAIL_SMTP_SECURITY="tls"
fi

# Configuration mémoire Scalingo
echo "  -> Scalingo detected"
MAX_METASPACE_SIZE=${MAX_METASPACE_SIZE:-512m}
JAVA_OPTS+=" -XX:+UnlockExperimentalVMOptions"
JAVA_OPTS+=" -XX:+UseContainerSupport"
JAVA_OPTS+=" -XX:-UseGCOverheadLimit"
JAVA_OPTS+=" -XX:+UseCompressedOops"
JAVA_OPTS+=" -XX:+UseCompressedClassPointers"
JAVA_OPTS+=" -XX:MaxMetaspaceSize=$MAX_METASPACE_SIZE"
JAVA_OPTS+=" -Xverify:none"
JAVA_OPTS+=" -XX:+UseG1GC"
JAVA_OPTS+=" -XX:+UseStringDeduplication"

JAVA_OPTS+=" -server"
JAVA_OPTS+=" -Djava.awt.headless=true"
JAVA_OPTS+=" -Dfile.encoding=UTF-8"

echo "Starting Metabase on internal port $MB_JETTY_PORT..."
java $JAVA_OPTS -jar ./target/uberjar/metabase.jar & METABASE_PID=$!

echo "Starting oauth2-proxy on public port $PORT..."
./bin/start_oauth2_proxy.sh & OAUTH2_PID=$!

# Graceful shutdown handler
term() {
    echo "Caught signal, stopping services..."
    kill -TERM "$METABASE_PID" "$OAUTH2_PID" 2>/dev/null || true
    wait
}
trap term TERM INT

# Monitor loop
while kill -0 "$METABASE_PID" 2>/dev/null && kill -0 "$OAUTH2_PID" 2>/dev/null; do
    sleep 1
done

echo "One of the processes exited unexpectedly. Stopping the rest..."
kill -TERM "$METABASE_PID" "$OAUTH2_PID" 2>/dev/null || true
wait
exit 1
